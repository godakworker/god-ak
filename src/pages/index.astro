---
import { getCollection } from "astro:content";

const sections = (await getCollection("sections")).sort((a, b) => a.data.order - b.data.order);
const name = "God Ak ☀️";
const caption =
	"Your arrogant God & findom with perfect feet, sweaty socks & too much god complex ☀️";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>God Ak</title>
		<meta name="description" content={caption} />
	</head>
	<body>
		<main>
			<header>
				<img src="/images/profile.jpg" alt="God Ak" width="96" height="96" />
				<h1>{name}</h1>
				<p class="caption">{caption}</p>
			</header>

			{
				sections.map(({ data }) => (
					<section>
						<h2>{data.title}</h2>
						<ul>
							{data.links.map((link) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener noreferrer">
										<img src={link.icon} alt="" width="48" height="48" />
										<span class="text">
											<span class="title">{link.title}</span>
											{link.description && <span class="desc">{link.description}</span>}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		min-height: 100vh;
		background: #f3f3f1;
		color: #111;
		font-family: system-ui, sans-serif;
	}
	main {
		max-width: 580px;
		margin: 0 auto;
		padding: 48px 16px;
	}
	header {
		text-align: center;
		margin-bottom: 32px;
	}
	header img {
		border-radius: 50%;
		object-fit: cover;
	}
	h1 {
		margin: 12px 0 4px;
		font-size: 1.4rem;
	}
	.caption {
		margin: 0;
		color: #444;
		font-size: 0.95rem;
	}
	h2 {
		margin: 28px 0 10px;
		font-size: 1.05rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}
	a {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 8px;
		background: #fff;
		border-radius: 16px;
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s;
	}
	a:hover {
		transform: scale(1.02);
	}
	a img {
		border-radius: 10px;
		object-fit: cover;
		flex: none;
	}
	.text {
		display: flex;
		flex-direction: column;
		flex: 1;
		text-align: center;
		padding-right: 48px;
	}
	.title {
		font-weight: 600;
	}
	.desc {
		font-size: 0.85rem;
		color: #555;
	}
</style>
