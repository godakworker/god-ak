---
import { getCollection } from "astro:content";
import LinkCard from "../components/LinkCard.astro";
import Rays from "../components/Rays.astro";
import "../styles/global.css";

const sections = (await getCollection("sections")).sort((a, b) => a.data.order - b.data.order);
const caption =
	"Your arrogant God & findom with perfect feet, sweaty socks & too much god complex ☀️";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>God Ak</title>
		<meta name="description" content={caption} />
	</head>
	<body>
		<main>
			<div class="page">
				<header>
					<div class="avatar">
						<Rays class="hero-rays" count={32} alternate />
						<img src="/images/avatar.webp" alt="God Ak" width="190" height="190" />
					</div>
					<h1>God Ak</h1>
					<p class="caption">{caption}</p>
				</header>

				{
					sections.map(({ data }) => (
						<section class:list={{ compact: data.links.every((l) => l.variant === "row") }}>
							<div class="section-head">
								<h2>{data.title}</h2>
								<div class="rule" />
							</div>
							{data.links.map((link) => (
								<LinkCard {...link} />
							))}
						</section>
					))
				}
			</div>
		</main>
	</body>
</html>
