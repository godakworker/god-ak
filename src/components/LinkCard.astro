---
import ArrowIcon from "./ArrowIcon.astro";
import Rays from "./Rays.astro";
import WheelIcon from "./WheelIcon.astro";

interface Props {
	title: string;
	url: string;
	icon?: string;
	variant?: "featured" | "card" | "game" | "row";
	badge?: string;
	description?: string;
}

const { title, url, icon, variant = "row", badge, description } = Astro.props;
---

<a class:list={["lk", variant, { glint: variant === "featured" }]} href={url} target="_blank" rel="noopener noreferrer">
	{variant === "featured" && <Rays class="card-rays" count={16} />}
	{variant === "game" ? <WheelIcon /> : icon && <img class="thumb" src={icon} alt="" />}
	<span class="body">
		{variant === "featured" && badge && <span class="pill dark">{badge}</span>}
		<span class="name">
			<span class="title">{title}</span>
			{variant !== "featured" && badge && <span class="pill">{badge}</span>}
		</span>
		{description && <span class="desc">{description}</span>}
	</span>
	{
		variant === "row" ? (
			<ArrowIcon class="go" size={20} />
		) : (
			<span class="go circle">
				<ArrowIcon size={variant === "featured" ? 22 : 20} />
			</span>
		)
	}
</a>
